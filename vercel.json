{
  "version": 2,
  "framework": null,
  "functions": {
    "api/index.php": {
      "maxDuration": 30
    },
    "api/manifest.php": {
      "maxDuration": 10
    }
  },
  "routes": [
    {
      "src": "/manifest.php",
      "dest": "/api/manifest.php"
    },
    {
      "src": "/(.*)",
      "dest": "/api/index.php"
    }
  ]
}